# URL base del backend Python FastAPI (senza slash finale)
VITE_API_BASE_URL=http://localhost:8000

# Identificativo predefinito operatore non sensibile (nessun segreto o credenziale)
VITE_DEFAULT_USER_ID=operatore_01

# Timeout richieste HTTP verso il RAG in millisecondi
VITE_REQUEST_TIMEOUT_MS=45000
