APP_ENV=development

# LLM Configuration (openai_compatible | ollama | openai | extractive)
# Modello generativo previsto dall'architettura: Qwen
LLM_PROVIDER=openai_compatible
LLM_MODEL=qwen2.5:7b-instruct
LLM_EXPECTED_MODEL_FAMILY=qwen
LLM_API_KEY=
LLM_BASE_URL=
# Per Ollama locale con Qwen impostare ad esempio:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.0

# Embeddings Configuration (huggingface | openai | hashing)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Vector Store (chroma)
VECTORSTORE_TYPE=chroma
VECTORSTORE_PATH=./storage/vectorstore
COLLECTION_NAME=operator_copilot_docs

# Data & Chunking
DATA_DIR=./data
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
SKIP_INDEX_FILES=true
DEDUP_NEAR_DUPLICATES=true
NEAR_DUP_THRESHOLD=0.90

# Database
DATABASE_URL=sqlite:///./storage/operator_copilot.db

# Smart Cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500

# Retrieval & Prompts
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.50
HYBRID_BM25_WEIGHT=0.35
RERANKER_ENABLED=true
PROMPT_VERSION=v1.1

# Knowledge-to-Course Engine
COURSE_PROMPT_VERSION=academy-v1.0
KNOWLEDGE_OBSOLETE_YEARS=4
PII_REDACT_BEFORE_LLM=true
ANALYSIS_MAX_WORKERS=2

# Adaptive Learning & Custom Quiz Engine
CUSTOM_QUIZ_PROMPT_VERSION=customquiz-v1.0
CUSTOM_QUIZ_DEFAULT_QUESTIONS=4
LEARNING_RETENTION_MIN_HOURS=24.0
CUSTOM_QUIZ_REUSE_HOURS=24

# Owner Learning Dashboard (Milestone 4)
OWNER_API_KEY=dev-owner-key-change-me
OWNER_DASHBOARD_CACHE_TTL_SECONDS=30
TOPIC_CRITICAL_ERROR_RATE=45.0
TOPIC_CRITICAL_MIN_GAPS=3
TOPIC_HIGH_ERROR_RATE=25.0
TOPIC_MEDIUM_ERROR_RATE=10.0

# History Retention & Security
HISTORY_RETENTION_DAYS=90
ADMIN_API_KEY=dev-admin-key-change-me
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DEMO_MODE_ENABLED=true
DEMO_SESSION_SECRET=dev-demo-session-secret-change-me
LOG_LEVEL=INFO
